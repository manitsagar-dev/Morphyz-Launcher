<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime stage card (actively downloading): orange rim glow iteration -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#17181D" android:centerColor="#1F1712" android:endColor="#17110D" />
            <corners android:radius="20dp" />
            <stroke android:width="1.2dp" android:color="#FF8C1A" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="#00FF8C1A" android:centerColor="#FF8C1A" android:endColor="#00FF8C1A" />
            <size android:height="2dp" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp" />
        </shape>
    </item>
    <item android:top="0.8dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="19dp" />
            <stroke android:width="0.8dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
