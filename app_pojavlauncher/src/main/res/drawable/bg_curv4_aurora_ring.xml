<?xml version="1.0" encoding="utf-8"?>
<!-- Seamless sweep-gradient ring (cyan -> orange -> cyan) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="ring"
    android:useLevel="false" android:innerRadiusRatio="2.35" android:thicknessRatio="55">
    <gradient android:type="sweep" android:startColor="#E6FFB25C"
        android:centerColor="#E6FF6D00" android:endColor="#E6FFB25C"/>
</shape>
