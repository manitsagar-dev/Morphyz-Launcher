<?xml version="1.0" encoding="utf-8"?>
<!-- PRIMARY BUTTON (SAVE/APPLY) — Morphyz orange gradient (the Morphyz Launcher
     PLAY-button identity) with dark bold text + built-in ripple.
     WCAG: #0D0D0D on #FF7A1A+ ≈ 7:1 contrast. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000">
    <item android:id="@android:id/background">
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#2A2A2A" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#FF8C1A"
                        android:endColor="#E65100" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#FF9E4A"
                        android:endColor="#FF6D00" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
